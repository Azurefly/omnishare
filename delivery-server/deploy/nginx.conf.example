# In the http block:
limit_req_zone $binary_remote_addr zone=omnishare_claims:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=omnishare_connections:10m;

# In the HTTPS server block:
location ^~ /delivery/ {
    access_log off;
    limit_req zone=omnishare_claims burst=20 nodelay;
    limit_conn omnishare_connections 8;
    client_max_body_size 8k;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
    proxy_pass http://127.0.0.1:18484;
}
