# In the http block:
limit_req_zone $binary_remote_addr zone=omnishare_claims:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=omnishare_connections:10m;

# BEGIN OmniShare HTTPS management zones (http context)
map "$request_method:$uri" $omnishare_management_allowed {
    default 0;
    "GET:/v1/deliveries" 1;
    "POST:/v1/deliveries" 1;
    "~^DELETE:/v1/deliveries/[0-9a-f]{64}$" 1;
}
limit_req_zone $binary_remote_addr zone=omnishare_management_ip:2m rate=5r/s;
limit_req_zone $server_name zone=omnishare_management_total:1m rate=15r/s;
limit_conn_zone $binary_remote_addr zone=omnishare_management_client:2m;
limit_conn_zone $server_name zone=omnishare_management_server:1m;
# END OmniShare HTTPS management zones

# In the HTTPS server block:
location ^~ /delivery/ {
    access_log off;
    limit_req zone=omnishare_claims burst=20 nodelay;
    limit_conn omnishare_connections 8;
    client_max_body_size 8k;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
    proxy_pass http://127.0.0.1:18484;
}
# BEGIN OmniShare HTTPS management paths (HTTPS server context)
location ~ "^/v1/deliveries(?:/[0-9a-f]{64})?$" {
    if ($omnishare_management_allowed = 0) { return 405; }
    if ($args != "") { return 400; }

    access_log off;
    limit_req zone=omnishare_management_ip burst=15 nodelay;
    limit_req zone=omnishare_management_total burst=30 nodelay;
    limit_req_status 429;
    limit_conn omnishare_management_client 4;
    limit_conn omnishare_management_server 24;
    limit_conn_status 429;
    client_max_body_size 17m;
    client_body_timeout 15s;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-OmniShare-Publisher $http_x_omnishare_publisher;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_connect_timeout 3s;
    proxy_send_timeout 30s;
    proxy_read_timeout 310s;
    proxy_pass http://127.0.0.1:18485;
}
location /v1/deliveries/ { return 404; }
# END OmniShare HTTPS management paths
