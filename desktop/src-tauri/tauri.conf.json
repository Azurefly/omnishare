{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniShare",
  "version": "1.0.0",
  "identifier": "com.azurefly.omnishare",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniShare",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "category": "Productivity",
    "shortDescription": "Private cross-platform content sharing hub",
    "longDescription": "OmniShare is a private multi-device content hub for personal, family, small-team and intranet environments."
  }
}
